    "radix-ui": "^1.6.7",
    "raf-throttle": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.5.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "prettier --write"
    ]
  }
}
