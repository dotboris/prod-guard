{
  "name": "prod-guard",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "web-ext run -s dist --devtools",
    "build": "webpack",
    "build:watch": "webpack --watch",
    "build:prod": "cross-env NODE_ENV=production webpack",
    "changeset": "changeset",
    "package": "web-ext build -s dist -o",
    "lint": "run-p 'lint:**' 'format:check'",
    "lint:js": "eslint .",
    "lint:web-ext": "web-ext lint -s dist",
    "lint:typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json}'",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/cli": "^10.5.10",
    "@storybook/react-webpack5": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@tsconfig/recommended": "^1.0.13",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/spy": "^4.1.11",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "10.5.10",
    "html-webpack-plugin": "^5.6.8",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-docgen-typescript": "^2.4.0",
    "sharp": "^0.35.4",
    "storybook": "^10.5.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "webpack": "^5.110.1",
    "webpack-clean-plugin": "^0.2.3",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
